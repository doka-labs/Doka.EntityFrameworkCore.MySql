<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.MySql.FunctionalTests</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.MySql.FunctionalTests</RootNamespace>
    <IsTestProject>true</IsTestProject>
    <PreserveCompilationContext>true</PreserveCompilationContext>
    <RunSettingsFilePath Condition="'$(DOKA_SPEC_TEST_TARGET)' == ''">$(MSBuildProjectDirectory)/LocalMariaDb118.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.MySql/Doka.EntityFrameworkCore.MySql.csproj" />
    <ProjectReference Include="../../src/Doka.EntityFrameworkCore.MySql.NetTopologySuite/Doka.EntityFrameworkCore.MySql.NetTopologySuite.csproj" />
    <ProjectReference Include="../Doka.EntityFrameworkCore.MySql.SpecificationAdapters/SpecificationAdapters.csproj" />
    <ProjectReference Include="../../tests/Doka.EntityFrameworkCore.MySql.TestUtilities/Doka.EntityFrameworkCore.MySql.TestUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Specification/SpecDispositions.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- One wildcard per family keeps new topic partials nested without per-file maintenance. -->
    <Compile Update="Capabilities/MySqlNewFeatureTests.*.cs">
      <DependentUpon>MySqlNewFeatureTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Metadata/MySqlIndexByteBudgetTests.*.cs">
      <DependentUpon>MySqlIndexByteBudgetTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Metadata/MySqlModelValidatorAndDdlTests.*.cs">
      <DependentUpon>MySqlModelValidatorAndDdlTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Metadata/MySqlModelingBaselineTests.*.cs">
      <DependentUpon>MySqlModelingBaselineTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Migrations/MySqlDesignTimeRoundTripTests.*.cs">
      <DependentUpon>MySqlDesignTimeRoundTripTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Migrations/MySqlGuidMigrationTests.*.cs">
      <DependentUpon>MySqlGuidMigrationTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Migrations/MySqlMigrationDdlCoverageTests.*.cs">
      <DependentUpon>MySqlMigrationDdlCoverageTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Migrations/MySqlMigrationDslTests.*.cs">
      <DependentUpon>MySqlMigrationDslTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Migrations/MySqlMigrationOperationHandlerTests.*.cs">
      <DependentUpon>MySqlMigrationOperationHandlerTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Query/MySqlMaterializedSourceLineageTests.*.cs">
      <DependentUpon>MySqlMaterializedSourceLineageTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Query/MySqlMaterializedSourceTranslationTests.*.cs">
      <DependentUpon>MySqlMaterializedSourceTranslationTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Query/MySqlPrimitiveCollectionParameterTests.*.cs">
      <DependentUpon>MySqlPrimitiveCollectionParameterTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Query/MySqlQueryTranslationCoverageTests.*.cs">
      <DependentUpon>MySqlQueryTranslationCoverageTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Query/MySqlQueryTranslationExtendedTests.*.cs">
      <DependentUpon>MySqlQueryTranslationExtendedTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Scaffolding/MySqlReverseEngineeringBaselineTests.*.cs">
      <DependentUpon>MySqlReverseEngineeringBaselineTests.cs</DependentUpon>
    </Compile>
    <Compile Update="Storage/MySqlTypeMappingBaselineTests.*.cs">
      <DependentUpon>MySqlTypeMappingBaselineTests.cs</DependentUpon>
    </Compile>
    <Compile Update="ValueGeneration/MySqlGuidStoreGenerationTests.*.cs">
      <DependentUpon>MySqlGuidStoreGenerationTests.cs</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>

<Project>
  <PropertyGroup Label="Target framework and build outputs">
    <TargetFramework>net10.0</TargetFramework>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
    <IncludeProjectNameInArtifactsPaths>true</IncludeProjectNameInArtifactsPaths>
    <UseArtifactsIntermediateOutput>true</UseArtifactsIntermediateOutput>
  </PropertyGroup>

  <PropertyGroup Label="Compiler defaults">
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Dependency restore and audit">
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <!-- WHY: Local development retains advisory warnings without promoting newly
         published findings to build errors. CI/release evaluation clears
         developer exceptions; failed advisory retrieval remains fatal. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

    <!-- WHY: Migration bundles restore referenced projects even with no-build. The deployment
         gate supplies this root so recursive RID restores cannot rewrite shipping locks. -->
    <NuGetLockFilePath
      Condition="'$(DokaIsolatedNuGetLockRoot)' != ''">$(DokaIsolatedNuGetLockRoot)/$(MSBuildProjectName).packages.lock.json
    </NuGetLockFilePath>
  </PropertyGroup>

  <PropertyGroup Label="Compiler analysis">
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <LangVersion>latestMajor</LangVersion>
  </PropertyGroup>

  <PropertyGroup Label="Shared build identity">
    <!-- WHY: Shipping packages, tests and engineering tools retain one version identity.
         Package metadata is scoped separately under src/Directory.Build.props. -->
    <VersionPrefix>10.6.2</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Label="Debug information and CI">
    <DebugType>portable</DebugType>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- WHY: Evaluate after the GitHub CI flag so inherited developer exceptions
         cannot silently weaken workflow or explicit release qualification. -->
    <WarningsNotAsErrors Condition="'$(ContinuousIntegrationBuild)' == 'true'" />
  </PropertyGroup>

  <PropertyGroup Label="Project defaults">
    <!-- WHY: Tests, examples and tools are build-only; src explicitly enables shipping artifacts. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>

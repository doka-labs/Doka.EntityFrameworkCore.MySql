<Project>
  <PropertyGroup Label="Central package management">
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <PropertyGroup Label="Production compatibility ranges">
    <!-- WHY: Consumers can adopt EF Core patches without a provider release.
         The next minor needs deliberate qualification; see ADR D-009. -->
    <DokaEfCoreVersion Condition="'$(DokaEfCoreVersion)' == ''">[10.0.8, 10.1.0)</DokaEfCoreVersion>

    <!-- WHY: Earlier drivers are affected by GHSA-473q-m89c-ghf8. Qualification
         exercises this security floor and the latest stable 2.x independently. -->
    <DokaMySqlConnectorVersion
        Condition="'$(DokaMySqlConnectorVersion)' == ''">[2.6.1, 3.0.0)</DokaMySqlConnectorVersion>
  </PropertyGroup>

  <ItemGroup Label="Production">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(DokaEfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(DokaEfCoreVersion)" />
    <PackageVersion Include="MySqlConnector" Version="$(DokaMySqlConnectorVersion)" />
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Cache production" Condition="'$(MSBuildProjectName)' == 'Doka.Caching.MySql'">
    <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup Label="Production analyzers">
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.6.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" Version="$(DokaEfCoreVersion)" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Testcontainers.MariaDb" Version="4.16.0" />
    <PackageVersion Include="Testcontainers.MySql" Version="4.16.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup Label="Benchmarks">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup Label="Example hosts">
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>
</Project>

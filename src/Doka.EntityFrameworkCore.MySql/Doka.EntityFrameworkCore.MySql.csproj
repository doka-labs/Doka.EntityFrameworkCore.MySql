<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.MySql</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.MySql</RootNamespace>
    <PackageId>Doka.EntityFrameworkCore.MySql</PackageId>
    <Title>Doka.EntityFrameworkCore.MySql</Title>
    <Description>Entity Framework Core 10 provider for MySQL 8.4 / 9.7 LTS and MariaDB 10.11 / 11.4 / 11.8 / 12.3 LTS. Native JSON, HiLo and sequences, advisory-lock-protected migrations, GUID Binary16/Char36 support, full query translation (REGEXP, MATCH/AGAINST, GROUP_CONCAT, JSON functions), trim- and AOT-aware.</Description>
    <PackageTags>entityframeworkcore;efcore;ef;orm;mysql;mariadb;mysqlconnector;database;provider</PackageTags>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>10.1.0</PackageValidationBaselineVersion>
    <!-- Private design-time dependencies are not part of the shipped package
         contract. Compare package metadata without recursively treating that
         build-only graph as consumer references. -->
    <RunPackageValidationWithoutReferences>true</RunPackageValidationWithoutReferences>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive; compile</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="MySqlConnector" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>

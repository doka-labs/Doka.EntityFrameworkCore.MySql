<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Doka.EntityFrameworkCore.MySql.NetTopologySuite</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.MySql</RootNamespace>
    <PackageId>Doka.EntityFrameworkCore.MySql.NetTopologySuite</PackageId>
    <Title>Doka.EntityFrameworkCore.MySql.NetTopologySuite</Title>
    <Description>Optional NetTopologySuite integration for Doka.EntityFrameworkCore.MySql. Adds spatial type mapping, scaffolding, spatial-index DDL, and NTS-backed query translation for the supported MySQL 8.4 / 9.7 and MariaDB 10.11 / 11.4 / 11.8 / 12.3 LTS lines. Install alongside Doka.EntityFrameworkCore.MySql and activate with UseNetTopologySuite().</Description>
    <PackageTags>entityframeworkcore;efcore;ef;orm;mysql;mariadb;spatial;nettopologysuite;geometry;geospatial</PackageTags>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>10.0.0</PackageValidationBaselineVersion>
    <!-- Private design-time dependencies are not part of the shipped package
         contract. Compare package metadata without recursively treating that
         build-only graph as consumer references. -->
    <RunPackageValidationWithoutReferences>true</RunPackageValidationWithoutReferences>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Doka.EntityFrameworkCore.MySql/Doka.EntityFrameworkCore.MySql.csproj" />
    <PackageReference Include="NetTopologySuite" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>
</Project>

{
  "schemaVersion": 2,
  "stability": "public",
  "sources": {
    "provider": "Doka.EntityFrameworkCore.MySql",
    "driver": "MySqlConnector",
    "efCoreDiagnosticListener": "Microsoft.EntityFrameworkCore"
  },
  "operations": [
    {
      "id": "server-version-resolution",
      "eventIds": [1000, 1005],
      "span": "db.serverversion.resolve",
      "metrics": ["doka_mysql_server_version_resolution_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"],
        "support_status": ["Future", "Legacy", "Supported", "Unvalidated"],
        "compatibility_mode": ["AllowUnsupported", "SupportedOnly"]
      }
    },
    {
      "id": "migration-lock-acquire",
      "eventIds": [1100, 1101, 1103],
      "span": "db.migration.lock",
      "metrics": ["doka_mysql_migration_lock_acquire_duration_seconds"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"],
        "outcome": ["acquired", "failed", "timeout"]
      }
    },
    {
      "id": "migration-lock-release-failure",
      "eventIds": [1102],
      "span": "db.migration.lock.release_failed",
      "metrics": ["doka_mysql_migration_lock_release_failed_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"]
      },
      "alert": "MYSQL-MIGRATION-LOCK-FAILURE",
      "runbookAnchor": "mysql-migration-lock-failure"
    },
    {
      "id": "migration-operation-handler",
      "eventIds": [1110, 1111, 1112, 1113, 1114],
      "span": "db.migration.operation_handler.generate",
      "metrics": [
        "doka_mysql_migration_operation_handler_calls_total",
        "doka_mysql_migration_operation_handler_failures_total",
        "doka_mysql_migration_operation_handler_contract_violations_total",
        "doka_mysql_migration_operation_handler_duration_seconds"
      ],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"],
        "doka.mysql.migrations.generation.mode": [
          "default",
          "idempotent",
          "idempotent_no_transactions",
          "no_transactions",
          "script",
          "script_idempotent",
          "script_idempotent_no_transactions",
          "script_no_transactions",
          "unknown"
        ]
      },
      "metricTagBounds": {
        "doka.mysql.migrations.handler.id": "validated registration snapshot; 1-200 ASCII characters, or provider-owned sentinel none/unknown",
        "doka.mysql.migrations.handler.outcome": "validated package outcome code, or provider-owned handler_failed/invalid_handler_result/recursive_provider_rendering/invalid_registration/unknown_operation sentinel",
        "doka.mysql.migrations.operation.type": "exact registered or encountered CLR operation type",
        "error.type": "stable MySqlMigrationHandlerFailureCode"
      },
      "alert": "MYSQL-MIGRATION-HANDLER-FAILURE",
      "runbookAnchor": "mysql-migration-operation-handler-failure"
    },
    {
      "id": "retry-attempt",
      "eventIds": [1500],
      "span": "db.retry.attempt",
      "metrics": ["doka_mysql_retry_attempts_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"],
        "outcome": ["attempt"]
      }
    },
    {
      "id": "retry-exhausted",
      "eventIds": [1501],
      "span": "db.retry.exhausted",
      "metrics": ["doka_mysql_retry_exhausted_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"]
      },
      "alert": "MYSQL-RETRY-EXHAUSTED",
      "runbookAnchor": "mysql-retry-exhausted"
    },
    {
      "id": "command-cancellation",
      "eventIds": [1502, 1503],
      "span": "db.operation.cancel",
      "metrics": ["doka_mysql_cancellation_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"],
        "path": ["hard", "soft"]
      },
      "alert": "MYSQL-HARD-CANCELLATION",
      "runbookAnchor": "mysql-hard-cancellation"
    },
    {
      "id": "command-timeout",
      "eventIds": [1504],
      "span": "db.operation.timeout",
      "metrics": ["doka_mysql_command_timeout_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"]
      },
      "alert": "MYSQL-COMMAND-TIMEOUT",
      "runbookAnchor": "mysql-command-timeout"
    },
    {
      "id": "commit-unknown",
      "eventIds": [1505],
      "span": "db.transaction.commit_unknown",
      "metrics": ["doka_mysql_commit_unknown_total"],
      "metricTagDomains": {
        "engine": ["mariadb", "mysql"]
      },
      "alert": "MYSQL-COMMIT-UNKNOWN",
      "runbookAnchor": "mysql-commit-unknown"
    }
  ],
  "spanTagContract": {
    "required": ["db.operation.name", "db.system.name"],
    "conditionallyAllowed": [
      "doka.mysql.cancellation.path",
      "doka.mysql.compatibility.mode",
      "doka.mysql.connection.state",
      "doka.mysql.engine.family",
      "doka.mysql.migrations.generation.mode",
      "doka.mysql.migrations.handler.id",
      "doka.mysql.migrations.handler.outcome",
      "doka.mysql.migrations.operation.type",
      "doka.mysql.retry.attempt",
      "doka.mysql.server.version",
      "doka.mysql.support.status",
      "error.type"
    ],
    "forbidden": [
      "db.migration.lock_name",
      "db.namespace",
      "db.query.text",
      "db.statement",
      "server.address",
      "server.port",
      "user.id"
    ]
  },
  "privacy": {
    "logExceptionObjects": false,
    "logRawConnectionStrings": false,
    "logRawDatabaseNames": false,
    "logRawSchemaOrObjectNames": false,
    "logSql": false,
    "boundedLogFieldDomains": {
      "configurationFailureReason": [
        "ApplicationTimeInvalid",
        "ConflictingConnectionPaths",
        "ConnectionPathChanged",
        "ForeignKeyNameTooLong",
        "GuidFormatChanged",
        "IndexNameTooLong",
        "MissingConnectionPath",
        "MissingServerVersion",
        "RetrySettingsChanged",
        "ServerVersionChanged",
        "TemporalTableInvalid",
        "UnsupportedServerVersion"
      ]
    },
    "objectScopeId": {
      "algorithm": "SHA-256",
      "hexCharacters": 16,
      "purpose": "diagnostic-correlation-only"
    },
    "defaultDriverPoolName": "Doka.EntityFrameworkCore.MySql"
  },
  "alerts": [
    {
      "id": "MYSQL-MIGRATION-HANDLER-FAILURE",
      "signal": "doka_mysql_migration_operation_handler_failures_total or doka_mysql_migration_operation_handler_contract_violations_total",
      "condition": "increase over five minutes is greater than zero",
      "severity": "critical",
      "runbookAnchor": "mysql-migration-operation-handler-failure"
    },
    {
      "id": "MYSQL-COMMIT-UNKNOWN",
      "signal": "doka_mysql_commit_unknown_total",
      "condition": "increase over five minutes is greater than zero",
      "severity": "critical",
      "runbookAnchor": "mysql-commit-unknown"
    },
    {
      "id": "MYSQL-HARD-CANCELLATION",
      "signal": "doka_mysql_cancellation_total{path=hard}",
      "condition": "rate over fifteen minutes exceeds the service baseline",
      "severity": "warning",
      "runbookAnchor": "mysql-hard-cancellation"
    },
    {
      "id": "MYSQL-MIGRATION-LOCK-FAILURE",
      "signal": "doka_mysql_migration_lock_release_failed_total",
      "condition": "increase over five minutes is greater than zero",
      "severity": "critical",
      "runbookAnchor": "mysql-migration-lock-failure"
    },
    {
      "id": "MYSQL-RETRY-EXHAUSTED",
      "signal": "doka_mysql_retry_exhausted_total",
      "condition": "increase over five minutes is greater than zero",
      "severity": "critical",
      "runbookAnchor": "mysql-retry-exhausted"
    },
    {
      "id": "MYSQL-COMMAND-TIMEOUT",
      "signal": "doka_mysql_command_timeout_total",
      "condition": "rate over fifteen minutes exceeds the service SLO budget",
      "severity": "warning",
      "runbookAnchor": "mysql-command-timeout"
    }
  ]
}

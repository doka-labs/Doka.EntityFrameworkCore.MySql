{
  "schemaVersion": 1,
  "policyVersion": "2026-09-01.1",
  "documentation": [
    "Candidate-produced release gates describe the candidate commit directly.",
    "Repository qualification is imported from the single merged pull request",
    "only when its successful workflow recorded the pull-request merge-ref tree",
    "that GitHub Actions tested and that tree is identical to the candidate tree.",
    "The raw pull-request head tree is identity, not qualification evidence.",
    "Commit ancestry, age, and path classifiers",
    "do not authorize reuse. Performance evidence is produced independently",
    "for engineering feedback and has no release-qualification authority.",
    "Release qualification covers the provider, spatial plugin, and standalone",
    "Doka.Caching.MySql package, including cache trim and NativeAOT execution."
  ],
  "selectionRule": {
    "version": 1,
    "eligibility": [
      "commit",
      "repository",
      "gate",
      "producer",
      "policyDigest",
      "conclusion"
    ],
    "order": [
      {
        "field": "workflowRunId",
        "direction": "greatest"
      },
      {
        "field": "runAttempt",
        "direction": "greatest"
      }
    ],
    "candidateProducedAttemptNotNewerThanAssembling": true,
    "frozenAtManifestAssembly": true
  },
  "gates": [
    {
      "id": "repository-qualification",
      "kind": "protected-check",
      "producerWorkflow": ".github/workflows/ci.yml",
      "checkName": "repository-qualification",
      "requiredBaseBranch": "main",
      "boundIdentities": [
        "commit",
        "treeId",
        "pullRequestNumber",
        "baseBranch",
        "qualifiedCommit",
        "qualifiedTreeId",
        "qualificationArtifactId",
        "workflowPath",
        "workflowRunId",
        "runAttempt",
        "event",
        "conclusion",
        "apiResourceId",
        "responseDigest"
      ]
    },
    {
      "id": "migration-deployment",
      "kind": "candidate-produced",
      "producerWorkflow": ".github/workflows/release-candidate.yml",
      "implementation": "eng/testing/test-migration-deployment.sh",
      "boundIdentities": [
        "commit",
        "treeId",
        "sourceHash",
        "workflowPath",
        "workflowRunId",
        "runAttempt",
        "conclusion",
        "artifactId",
        "artifactDigest"
      ]
    },
    {
      "id": "runtime-posture",
      "kind": "candidate-produced",
      "producerWorkflow": ".github/workflows/release-candidate.yml",
      "implementation": "eng/testing/test-runtime-posture.sh",
      "boundIdentities": [
        "commit",
        "treeId",
        "sourceHash",
        "workflowPath",
        "workflowRunId",
        "runAttempt",
        "conclusion",
        "artifactId",
        "artifactDigest"
      ]
    },
    {
      "id": "efcore-patch-matrix",
      "kind": "candidate-produced",
      "producerWorkflow": ".github/workflows/release-candidate.yml",
      "implementation": "eng/testing/test-efcore-matrix.sh",
      "boundIdentities": [
        "commit",
        "treeId",
        "sourceHash",
        "dependencySnapshotDigest",
        "workflowPath",
        "workflowRunId",
        "runAttempt",
        "conclusion",
        "artifactId",
        "artifactDigest"
      ]
    },
    {
      "id": "mysqlconnector-patch-matrix",
      "kind": "candidate-produced",
      "producerWorkflow": ".github/workflows/release-candidate.yml",
      "implementation": "eng/testing/test-mysqlconnector-matrix.sh",
      "boundIdentities": [
        "commit",
        "treeId",
        "sourceHash",
        "dependencySnapshotDigest",
        "workflowPath",
        "workflowRunId",
        "runAttempt",
        "conclusion",
        "artifactId",
        "artifactDigest"
      ]
    }
  ],
  "trustedTagSigners": {
    "allowedSignersFile": ".github/allowed_signers",
    "requireApiVerification": true,
    "requireLocalVerification": true,
    "signers": [
      {
        "principals": [
          "kdominic@gmx.de",
          "54367198+kdominic89@users.noreply.github.com"
        ],
        "keyType": "ssh-ed25519",
        "fingerprint": "SHA256:Nkug92pcXECxr/ahDdfnvayqT8E4gWRYHIuUXQzstZI"
      }
    ]
  },
  "requiredProtectedChecks": [
    "repository-qualification"
  ]
}

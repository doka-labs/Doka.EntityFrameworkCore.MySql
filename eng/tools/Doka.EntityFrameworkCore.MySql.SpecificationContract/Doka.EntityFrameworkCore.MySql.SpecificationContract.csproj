<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Doka.EntityFrameworkCore.MySql.SpecificationContract</AssemblyName>
    <RootNamespace>Doka.EntityFrameworkCore.MySql.SpecificationContract</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational.Specification.Tests" />
    <!--
      Pin the centrally reviewed transitive version without loading the Visual
      Studio test adapter into this non-test engineering tool.
    -->
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>all</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Doka.EntityFrameworkCore.MySql.Tests" />
  </ItemGroup>
</Project>

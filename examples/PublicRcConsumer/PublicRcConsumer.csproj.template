<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>@TFM@</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- WHY: Brackets require these exact published RCs, not minimum versions. -->
    <PackageReference Include="Doka.EntityFrameworkCore.MySql" Version="[@DOKA@]" />
    <PackageReference Include="Doka.EntityFrameworkCore.MySql.NetTopologySuite" Version="[@DOKA@]" />
    <PackageReference Include="Doka.Caching.MySql" Version="[@DOKA@]" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="[@EF@]" />
  </ItemGroup>
</Project>

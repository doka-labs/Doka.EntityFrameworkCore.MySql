<Project>
  <!-- Import the repository-root Directory.Build.props so examples inherit shared settings. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- Example projects use implicit usings for brevity;
         the main provider disables them to enforce explicit imports. -->
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Examples are illustrative; they are never packed and emit no XML doc artifact. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Every database-backed sample receives the same isolated database and
      engine-selection contract. Keeping this plumbing shared makes the
      scenario code copyable without duplicating credentials and port logic.
    -->
    <Compile Include="$(MSBuildThisFileDirectory)ExampleDatabaseConfiguration.cs"
             Link="ExampleDatabaseConfiguration.cs" />
  </ItemGroup>
</Project>
